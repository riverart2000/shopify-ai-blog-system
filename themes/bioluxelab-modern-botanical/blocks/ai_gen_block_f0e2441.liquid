{% doc %}
  @prompt
    Create a section called "Blog Hub Links" that displays a clean grid of five clickable cards linking to these blog sections: 1. Stress, Mindfulness & Mental Wellness Hub - /blogs/stress-mindfulness-mental-wellness-hub, 2. Sleep & Recovery Hub - /blogs/sleep-recovery-hub, 3. Pain Relief & Posture Fix Hub - /blogs/pain-relief-posture-fix-hub, 4. Home Fitness & Mobility Hub - /blogs/home-fitness-mobility-hub, 5. Inside the Products - /blogs/inside-the-products. Style for a premium health and wellness brand. Hardcode all links and titles.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blog-hub-links-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-blog-hub-links__heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-blog-hub-links__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-blog-hub-links__card-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: {{ block.settings.card_padding }}px;
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    text-decoration: none;
    transition: all 0.3s ease;
    min-height: {{ block.settings.card_min_height }}px;
    text-align: center;
  }

  .ai-blog-hub-links__card-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.card_hover_background }};
    border-color: {{ block.settings.card_hover_border_color }};
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }

  .ai-blog-hub-links__card-title-{{ ai_gen_id }} {
    color: {{ block.settings.card_text_color }};
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 600;
    margin: 0;
    transition: color 0.3s ease;
  }

  .ai-blog-hub-links__card-{{ ai_gen_id }}:hover .ai-blog-hub-links__card-title-{{ ai_gen_id }} {
    color: {{ block.settings.card_hover_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-blog-hub-links__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-blog-hub-links__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-blog-hub-links__card-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.card_title_size }}px * 0.9);
    }
  }
{% endstyle %}

<blog-hub-links-{{ ai_gen_id }}
  class="ai-blog-hub-links-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <h2 class="ai-blog-hub-links__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  {% endif %}

  <div class="ai-blog-hub-links__grid-{{ ai_gen_id }}">
    <a
      href="/blogs/stress-mindfulness-mental-wellness-hub"
      class="ai-blog-hub-links__card-{{ ai_gen_id }}"
    >
      <h3 class="ai-blog-hub-links__card-title-{{ ai_gen_id }}">
        Stress, Mindfulness & Mental Wellness Hub
      </h3>
    </a>

    <a
      href="/blogs/sleep-recovery-hub"
      class="ai-blog-hub-links__card-{{ ai_gen_id }}"
    >
      <h3 class="ai-blog-hub-links__card-title-{{ ai_gen_id }}">
        Sleep & Recovery Hub
      </h3>
    </a>

    <a
      href="/blogs/pain-relief-posture-fix-hub"
      class="ai-blog-hub-links__card-{{ ai_gen_id }}"
    >
      <h3 class="ai-blog-hub-links__card-title-{{ ai_gen_id }}">
        Pain Relief & Posture Fix Hub
      </h3>
    </a>

    <a
      href="/blogs/home-fitness-mobility-hub"
      class="ai-blog-hub-links__card-{{ ai_gen_id }}"
    >
      <h3 class="ai-blog-hub-links__card-title-{{ ai_gen_id }}">
        Home Fitness & Mobility Hub
      </h3>
    </a>

    <a
      href="/blogs/inside-the-products"
      class="ai-blog-hub-links__card-{{ ai_gen_id }}"
    >
      <h3 class="ai-blog-hub-links__card-title-{{ ai_gen_id }}">
        Inside the Products
      </h3>
    </a>
  </div>
</blog-hub-links-{{ ai_gen_id }}>

<script>
  (function() {
    class BlogHubLinks{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.cards = this.querySelectorAll('.ai-blog-hub-links__card-{{ ai_gen_id }}');
      }
    }

    customElements.define('blog-hub-links-{{ ai_gen_id }}', BlogHubLinks{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Blog hub links",
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore Our Blog Hubs"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Heading spacing",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Gap between cards",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 15,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "card_min_height",
      "label": "Card minimum height",
      "min": 100,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "card_border_width",
      "label": "Card border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Card title size",
      "min": 14,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#c9a227"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#0f1a12"
    },
    {
      "type": "color",
      "id": "card_hover_background",
      "label": "Card hover background",
      "default": "#1a6b3c"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card text color",
      "default": "#f0ede6"
    },
    {
      "type": "color",
      "id": "card_hover_text_color",
      "label": "Card hover text color",
      "default": "#c9a227"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color",
      "default": "#1a6b3c"
    },
    {
      "type": "color",
      "id": "card_hover_border_color",
      "label": "Card hover border color",
      "default": "#c9a227"
    }
  ],
  "presets": [
    {
      "name": "Blog hub links"
    }
  ],
  "tag": null
}
{% endschema %}