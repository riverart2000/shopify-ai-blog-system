{% doc %}
  @prompt
    Create a "Blog Hub Links" block for the blog page that displays cards linking to the following blogs. Each card should show the blog title and link to the blog URL. Match a premium, spa-like wellness aesthetic with clean card styling, hover effects, and a grid layout. The blogs to include are:
    1. Inside the Products - /blogs/inside-the-products
    2. Stress, Mindfulness & Mental Wellness Hub - /blogs/stress-mindfulness-mental-wellness-hub
    3. Home Fitness & Mobility Hub - /blogs/home-fitness-mobility-hub
    4. Pain Relief & Posture Fix Hub - /blogs/pain-relief-posture-fix-hub
    5. Sleep & Recovery Hub - /blogs/sleep-recovery-hub
    6. The Ultimate Health & Wellness Resource - /blogs/the-ultimate-health-wellness-resource
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blog-hub-links-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-blog-hub-links__heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-blog-hub-links__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-blog-hub-links__card-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: {{ block.settings.card_padding }}px;
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    text-decoration: none;
    transition: all 0.3s ease;
    min-height: {{ block.settings.card_min_height }}px;
    text-align: center;
  }

  .ai-blog-hub-links__card-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.card_hover_background }};
    border-color: {{ block.settings.card_hover_border_color }};
    transform: translateY(-{{ block.settings.hover_lift }}px);
    box-shadow: 0 {{ block.settings.hover_shadow_offset }}px {{ block.settings.hover_shadow_blur }}px {{ block.settings.hover_shadow_color }};
  }

  .ai-blog-hub-links__card-title-{{ ai_gen_id }} {
    color: {{ block.settings.card_text_color }};
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: {{ block.settings.card_title_weight }};
    margin: 0;
    transition: color 0.3s ease;
  }

  .ai-blog-hub-links__card-{{ ai_gen_id }}:hover .ai-blog-hub-links__card-title-{{ ai_gen_id }} {
    color: {{ block.settings.card_hover_text_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-blog-hub-links__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-blog-hub-links__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.card_gap_mobile }}px;
    }

    .ai-blog-hub-links__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-blog-hub-links__card-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.card_title_size | times: 0.85 }}px;
    }

    .ai-blog-hub-links__card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.75 }}px;
      min-height: {{ block.settings.card_min_height | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-blog-hub-links-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-blog-hub-links__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  {% endif %}

  <div class="ai-blog-hub-links__grid-{{ ai_gen_id }}">
    {% if block.settings.blog_1_enabled %}
      <a href="{{ block.settings.blog_1_url }}" class="ai-blog-hub-links__card-{{ ai_gen_id }}">
        <h3 class="ai-blog-hub-links__card-title-{{ ai_gen_id }}">{{ block.settings.blog_1_title }}</h3>
      </a>
    {% endif %}

    {% if block.settings.blog_2_enabled %}
      <a href="{{ block.settings.blog_2_url }}" class="ai-blog-hub-links__card-{{ ai_gen_id }}">
        <h3 class="ai-blog-hub-links__card-title-{{ ai_gen_id }}">{{ block.settings.blog_2_title }}</h3>
      </a>
    {% endif %}

    {% if block.settings.blog_3_enabled %}
      <a href="{{ block.settings.blog_3_url }}" class="ai-blog-hub-links__card-{{ ai_gen_id }}">
        <h3 class="ai-blog-hub-links__card-title-{{ ai_gen_id }}">{{ block.settings.blog_3_title }}</h3>
      </a>
    {% endif %}

    {% if block.settings.blog_4_enabled %}
      <a href="{{ block.settings.blog_4_url }}" class="ai-blog-hub-links__card-{{ ai_gen_id }}">
        <h3 class="ai-blog-hub-links__card-title-{{ ai_gen_id }}">{{ block.settings.blog_4_title }}</h3>
      </a>
    {% endif %}

    {% if block.settings.blog_5_enabled %}
      <a href="{{ block.settings.blog_5_url }}" class="ai-blog-hub-links__card-{{ ai_gen_id }}">
        <h3 class="ai-blog-hub-links__card-title-{{ ai_gen_id }}">{{ block.settings.blog_5_title }}</h3>
      </a>
    {% endif %}

    {% if block.settings.blog_6_enabled %}
      <a href="{{ block.settings.blog_6_url }}" class="ai-blog-hub-links__card-{{ ai_gen_id }}">
        <h3 class="ai-blog-hub-links__card-title-{{ ai_gen_id }}">{{ block.settings.blog_6_title }}</h3>
      </a>
    {% endif %}
  </div>
</div>

