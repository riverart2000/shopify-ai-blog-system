{% comment %}
  App embed (target: head) — injects Open Graph + Twitter Card meta tags on blog
  article pages so posts preview correctly when shared on Pinterest, LinkedIn,
  Facebook, Substack, X, etc. Enable once from Theme editor → App embeds.
{% endcomment %}

{% if block.settings.enable_article_meta and template.name == 'article' and article %}
  {%- liquid
    assign social_desc = article.metafields.global.description_tag
    if social_desc == blank
      assign social_desc = article.excerpt_or_content | strip_html | strip | truncatewords: 50
    endif
    assign social_image = article.image
    if social_image == blank
      assign social_image = page_image
    endif
  -%}
  <meta property="og:type" content="article">
  <meta property="og:title" content="{{ article.title | escape }}">
  {% if social_desc != blank %}<meta property="og:description" content="{{ social_desc | escape }}">{% endif %}
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:site_name" content="{{ shop.name | escape }}">
  {% if social_image != blank %}<meta property="og:image" content="{{ social_image | image_url: width: 1200 | prepend: 'https:' }}">{% endif %}
  <meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' }}">
  {% if article.author != blank %}<meta property="article:author" content="{{ article.author | escape }}">{% endif %}
  {% for tag in article.tags limit: 6 %}<meta property="article:tag" content="{{ tag | escape }}">{% endfor %}
  <meta name="twitter:card" content="summary_large_image">
  {% if block.settings.twitter_site != blank %}<meta name="twitter:site" content="{{ block.settings.twitter_site }}">{% endif %}
  <meta name="twitter:title" content="{{ article.title | escape }}">
  {% if social_desc != blank %}<meta name="twitter:description" content="{{ social_desc | escape }}">{% endif %}
  {% if social_image != blank %}<meta name="twitter:image" content="{{ social_image | image_url: width: 1200 | prepend: 'https:' }}">{% endif %}
{% endif %}

{% schema %}
{
  "name": "Social sharing meta tags",
  "target": "head",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_article_meta",
      "label": "Add Open Graph & Twitter tags on blog articles",
      "info": "Improves link previews on Pinterest, LinkedIn, Facebook, X and other platforms. Disable if your theme already outputs these tags to avoid duplicates.",
      "default": true
    },
    {
      "type": "text",
      "id": "twitter_site",
      "label": "X / Twitter @site handle (optional)",
      "info": "e.g. @yourbrand"
    }
  ]
}
{% endschema %}
