{% assign review_cache = app.metafields.reviews.store_cache.value %}
<section class="bl-reviews" data-bl-reviews data-review-type="store" data-endpoint="https://revenuemindproai.com:8443/reviews-public?shop={{ shop.permanent_domain | url_encode }}" style="--bl-review-accent:{{ block.settings.accent_colour }};--bl-review-surface:{{ block.settings.surface_colour }}" {{ block.shopify_attributes }}>
  <div class="bl-reviews__shell">
    <div class="bl-reviews__head"><div><p class="bl-reviews__eyebrow">BioLuxeLab customers</p><h2 class="bl-reviews__title">{{ block.settings.heading | escape }}</h2><p class="bl-reviews__intro">{{ block.settings.introduction | escape }}</p></div><button class="bl-reviews__button" type="button" data-review-open>Review our store</button></div>
    <div class="bl-reviews__message" data-review-message hidden aria-live="polite"></div>
    {% render 'customer-review-form' %}
    <div class="bl-reviews__summary" data-review-summary aria-live="polite">{% render 'customer-review-cache', review_cache: review_cache %}</div>
    <div class="bl-reviews__tools"><span class="bl-reviews__filter">Reviews about service, delivery and the BioLuxeLab experience</span><label>Sort <select data-review-sort><option value="newest">Newest</option><option value="highest">Highest rated</option><option value="lowest">Lowest rated</option><option value="oldest">Oldest</option></select></label></div>
    <div class="bl-reviews__list" data-review-list>{% render 'customer-review-cards', review_cache: review_cache %}</div>
    <div class="bl-reviews__more"><button class="bl-reviews__button bl-reviews__button--secondary" type="button" data-review-more hidden>Load more reviews</button></div>
  </div>
</section>
{% schema %}
{"name":"Store reviews","target":"section","stylesheet":"customer-reviews.css","javascript":"customer-reviews.js","enabled_on":{"templates":["index","page"]},"settings":[{"type":"text","id":"heading","label":"Heading","default":"The BioLuxeLab experience"},{"type":"textarea","id":"introduction","label":"Introduction","default":"Tell us about our service, delivery, packaging and your overall shopping experience."},{"type":"color","id":"accent_colour","label":"Accent colour","default":"#315c4c"},{"type":"color","id":"surface_colour","label":"Background colour","default":"#f5f1e8"}]}
{% endschema %}
