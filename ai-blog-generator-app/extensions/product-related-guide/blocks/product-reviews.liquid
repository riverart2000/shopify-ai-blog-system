{% liquid
  assign rating_value = product.metafields.custom.ai_reviews_rating.value | default: 0
  assign rating_count = product.metafields.custom.ai_reviews_count.value | default: 0
  assign review_cache = product.metafields.custom.ai_reviews_cache.value
%}
<section id="bioluxe-reviews" class="bl-reviews" data-bl-reviews data-review-type="product" data-product-id="{{ product.id }}" data-product-handle="{{ product.handle | escape }}" data-product-title="{{ product.title | escape }}" data-endpoint="https://revenuemindproai.com:8443/reviews-public?shop={{ shop.permanent_domain | url_encode }}" style="--bl-review-accent:{{ block.settings.accent_colour }};--bl-review-surface:{{ block.settings.surface_colour }}" {{ block.shopify_attributes }}>
  <div class="bl-reviews__shell">
    <div class="bl-reviews__head"><div><p class="bl-reviews__eyebrow">Customer feedback</p><h2 class="bl-reviews__title">{{ block.settings.heading | escape }}</h2><p class="bl-reviews__intro">{{ block.settings.introduction | escape }}</p></div><button class="bl-reviews__button" type="button" data-review-open>Write a review</button></div>
    <div class="bl-reviews__message" data-review-message hidden aria-live="polite"></div>
    {% render 'customer-review-form' %}
    <div class="bl-reviews__summary" data-review-summary aria-live="polite">{% render 'customer-review-cache', review_cache: review_cache %}</div>
    <div class="bl-reviews__tools"><span class="bl-reviews__filter">Select a rating bar to filter</span><label>Sort <select data-review-sort><option value="newest">Newest</option><option value="highest">Highest rated</option><option value="lowest">Lowest rated</option><option value="oldest">Oldest</option></select></label></div>
    <div class="bl-reviews__list" data-review-list>{% render 'customer-review-cards', review_cache: review_cache %}</div>
    <div class="bl-reviews__more"><button class="bl-reviews__button bl-reviews__button--secondary" type="button" data-review-more hidden>Load more reviews</button></div>
  </div>
</section>
{% if rating_count > 0 %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"Product","@id":{{ canonical_url | append: '#product' | json }},"name":{{ product.title | json }},"aggregateRating":{"@type":"AggregateRating","ratingValue":{{ rating_value | json }},"reviewCount":{{ rating_count | json }},"bestRating":5,"worstRating":1}}</script>{% endif %}
{% schema %}
{"name":"Product reviews","target":"section","stylesheet":"customer-reviews.css","javascript":"customer-reviews.js","enabled_on":{"templates":["product"]},"settings":[{"type":"text","id":"heading","label":"Heading","default":"What customers say"},{"type":"textarea","id":"introduction","label":"Introduction","default":"Genuine feedback from BioLuxeLab customers. Every review is checked for relevance and authenticity before publication."},{"type":"color","id":"accent_colour","label":"Accent colour","default":"#315c4c"},{"type":"color","id":"surface_colour","label":"Background colour","default":"#ffffff"}]}
{% endschema %}
