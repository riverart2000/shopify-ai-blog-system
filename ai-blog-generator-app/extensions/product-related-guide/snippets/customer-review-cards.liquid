{% if review_cache != blank and review_cache.reviews != blank %}
  {% for review in review_cache.reviews %}
    <article class="bl-review-card">
      <div class="bl-review-card__top"><div><div class="bl-reviews__stars" aria-label="{{ review.rating }} out of 5 stars">{% for star in (1..5) %}{% if star <= review.rating %}★{% else %}☆{% endif %}{% endfor %}</div><h3 class="bl-review-card__title">{{ review.review_title | escape }}</h3><div class="bl-review-card__meta">{{ review.reviewer_name | escape }}</div></div>{% if review.verified_purchase %}<span class="bl-review-card__verified">Verified purchase</span>{% endif %}</div>
      <div class="bl-review-card__body">{{ review.review_body | escape | newline_to_br }}</div>
      {% if review.photo_url != blank %}<img class="bl-review-card__photo" src="{{ review.photo_url | escape }}" alt="Photo submitted with review by {{ review.reviewer_name | escape }}" loading="lazy" width="600" height="600">{% endif %}
      {% if review.merchant_reply != blank %}<div class="bl-review-card__reply"><strong>Response from BioLuxeLab</strong><div>{{ review.merchant_reply | escape | newline_to_br }}</div></div>{% endif %}
    </article>
  {% endfor %}
{% endif %}
