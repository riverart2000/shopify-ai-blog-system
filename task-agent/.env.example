# Copy to .env and fill in. .env is git-ignored — never commit secrets.

# Local model on oMLX (same server the Social Engine uses)
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=gemma-4-31b-it-8bit
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_THINKING=true           # agent work thinks; the Social Engine keeps thinking off on the same model

# Storage (relative to task-agent/)
DB_PATH=data/task_agent.db
LOG_DIR=logs
PROFILES_DIR=profiles

# Worker budgets
POLL_SECONDS=10
MAX_STEPS=60
MAX_MINUTES=20
MAX_ATTEMPTS=3

# Email (Phase C) — IMAP/SMTP. Use an app password, not your main password.
# IMAP_HOST=imap.gmail.com
# IMAP_USER=
# IMAP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# Private API for the Shopify admin app (same value in the app server .env)
TASK_AGENT_API_KEY=

# Social Engine (the live server): same value as AI_BLOG_BACKEND_API_KEY in the release .env
SOCIAL_API_KEY=

# Telegram: only this account may use the bot (token is saved in the Keychain from the Settings page)
TELEGRAM_OWNER_USERNAME=
# TELEGRAM_SUMMARY_HOUR=8
