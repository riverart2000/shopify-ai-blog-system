# Copy this to .env and fill in all values before starting the server.

# ── Server ──────────────────────────────────────────────────────────────────
# Your public domain (must match the TLS cert below)
DOMAIN=shopify-blogs.yourdomain.com

# Paths to TLS cert obtained via: certbot certonly --manual --preferred-challenges dns
CERT_FILE=/etc/letsencrypt/live/shopify-blogs.yourdomain.com/fullchain.pem
KEY_FILE=/etc/letsencrypt/live/shopify-blogs.yourdomain.com/privkey.pem

# Set to true — Caddy handles TLS so the app sits behind a secure proxy
HTTPS_ONLY=true

# Optional path prefix when this backend is mounted behind a reverse proxy.
# Leave blank for the primary instance; set to /theplayersgolfhouse for the
# secondary instance routed under https://your-domain:8443/theplayersgolfhouse/
ROOT_PATH=/theplayersgolfhouse

# Override the SQLite location per backend instance.
DB_PATH=data/ai_blog_server.db

# Use a unique cookie name when running multiple backend instances on the same host.
SESSION_COOKIE_NAME=aiblog_session_theplayersgolfhouse

# Random 32+ char string for signing session cookies
# Generate one: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=changeme

# ── Shopify ─────────────────────────────────────────────────────────────────
SHOPIFY_CLIENT_ID_PLAYERSGOLFHOUSE=
SHOPIFY_CLIENT_SECRET_PLAYERSGOLFHOUSE=
MYSHOPIFY_DOMAIN=theplayersgolfhouse.myshopify.com

# ── AI APIs ─────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
GROK_API_KEY=
REPLICATE_API_TOKEN=
